# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # serverless uniquement, ne jamais exposer
SUPABASE_ANON_KEY=your-anon-key                   # optionnel côté client si nécessaire

# ── Resend (emails transactionnels) ──────────────────────────────────────────
RESEND_API_KEY=re_your_key

# ── Notifications ────────────────────────────────────────────────────────────
EMAIL_TO=votre@email.com

# ── Liens externes (préfixe VITE_ = exposé au client via import.meta.env) ──
VITE_SAFTI_LISTINGS_URL=https://www.safti.fr/votre-profil

# ── Analytics (optionnel) ─────────────────────────────────────────────────────
# Google Analytics 4 — obtenir l'ID sur analytics.google.com
# Laisser vide pour désactiver. Ne se charge qu'en production.
VITE_GA4_ID=G-XXXXXXXXXX
